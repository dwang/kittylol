{
	"name": "kittylol",
	"version": "0.1.0",
	"packageManager": "pnpm@11.13.1",
	"private": true,
	"type": "module",
	"scripts": {
		"predeploy": "pnpm check",
		"deploy": "wrangler deploy",
		"dev": "wrangler dev",
		"start": "wrangler dev",
		"format": "prettier --write .",
		"format:check": "prettier --check .",
		"test": "vitest run",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit && tsc --project test/tsconfig.json --noEmit",
		"check": "pnpm format:check && pnpm typecheck && pnpm test",
		"cf-typegen": "wrangler types",
		"cf-typegen:check": "wrangler types --check"
	},
	"devDependencies": {
		"@cloudflare/vitest-plugin": "^1.8.3",
		"prettier": "^3.10.1",
		"typescript": "^7.0.2",
		"vitest": "~5.1.0",
		"wrangler": "^4.163.0"
	}
}
